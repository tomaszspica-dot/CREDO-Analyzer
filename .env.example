# CREDO Analyzer
#
# Copy this file to:
#
#   .env
#
# .env is local and ignored by Git.

# Default: local machine only.
CREDO_HOST=127.0.0.1
CREDO_PORT=8091

# Automatically open the browser after startup:
# 1 = yes
# 0 = no
CREDO_OPEN_BROWSER=1

# Optional path overrides.
# Leave commented to use directories inside the repository.
#
# CREDO_DATA_DIR="/path/to/data"
# CREDO_VENV_DIR="/path/to/venv"
# CREDO_RUN_DIR="/path/to/run"
# CREDO_LOG_DIR="/path/to/logs"
# CREDO_APP_DIR="/path/to/app"

# Optional Python executable.
#
# CREDO_PYTHON="/path/to/python"

# Optional custom environment file.
#
# CREDO_ENV_FILE="/path/to/custom.env"
